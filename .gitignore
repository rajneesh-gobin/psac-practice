# Pre-built question bundles (generated at deploy time by netlify/build-questions.js)
netlify/question-bundles/

# Local secrets — never commit
.env

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Installed dependencies. Needed on disk for a LOCAL netlify build (the
# functions bundle @supabase/supabase-js), but never committed — and with
# publish = "." they must not be served as static files either.
node_modules/

# Question-import conflict artefacts and source backups.
# ⚠ protected-conflicts.json carries the DATABASE version of a question,
# correct answers included. It must never be committed.
.import-conflicts/

# Local Netlify folder
.netlify
