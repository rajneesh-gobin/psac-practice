# Pre-built question bundles (generated at deploy time by netlify/build-questions.js)
netlify/question-bundles/

# Local secrets — never commit
.env

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Installed dependencies. Needed on disk for a LOCAL netlify build (the
# functions bundle @supabase/supabase-js), but never committed — and with
# publish = "." they must not be served as static files either.
node_modules/

# Question-import conflict artefacts and source backups.
# ⚠ protected-conflicts.json carries the DATABASE version of a question,
# correct answers included. It must never be committed.
.import-conflicts/

# Local Netlify folder
.netlify

# Staging dir built by scripts/prepare-deploy.js — never committed, never served
.deploy/

# MIE textbook PDFs/RARs — 1.2 GB of source material, 10 files over GitHub's
# 50 MB warning. They were only ever input to the book-syllabus audit, whose
# OUTPUT is kept in docs/book-syllabus-audit/. Keep local copies outside the
# repo if you need to re-run it.
books/
.secrets.local.md

# ⚠⚠ THE ANDROID SIGNING KEY. This is the one file in the whole project that
# cannot be regenerated: lose it and you cannot ship an update to the same Play
# listing ever again - new listing, zero reviews, zero installs. Publish it and
# anyone can sign an app that Android will accept as yours.
# ⚠ It is supposed to live OUTSIDE this repo entirely (see docs/convert_to_app.md).
#   These lines are the second gate, for the day someone copies it in "just to
#   build quickly" - the same mistake that once shipped .env to the public site.
*.keystore
*.jks
*.p12
*.keystore.*
keystore.properties

# The Bubblewrap/TWA project, if anyone ever generates it inside the repo.
# It carries signing config and a full Gradle build - neither belongs here.
nouklass-android/
twa-manifest.json
